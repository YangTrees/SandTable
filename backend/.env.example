# SQLite（默认）：sqlite:///./data/sandplay.db
# PostgreSQL：postgresql+psycopg://sandplay:password@127.0.0.1:5432/sandplay
DATABASE_URL=sqlite:///./data/sandplay.db

# 对外访问地址，用于生成二维码里的分享链接
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 咨询师后台令牌（生产环境必须替换）
COUNSELOR_TOKEN=dev-counselor-token

# ===== 多模态模型（默认：火山方舟 Doubao-Seed-2.0-Lite）=====
# 方舟 OpenAI 兼容接口
MULTIMODAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MULTIMODAL_MODEL=doubao-seed-2-0-lite-260428
# 方舟 API Key：填入后生效
MULTIMODAL_API_KEY=
MULTIMODAL_TIMEOUT_SECONDS=300

# 如需改用其他 OpenAI 兼容服务，替换为对应地址与模型：
# MULTIMODAL_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_MODEL=gpt-4o-mini

# 多模态不可用或未配置时是否使用本地演示报告
# 正式测试建议 false，失败时直接报错，避免被演示报告掩盖
ALLOW_DEMO_REPORT=false

# 允许前端 file:// 本地页面跨域调用
CORS_ORIGINS=*
