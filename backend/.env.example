# 多模态报告生成配置（复制为 backend/.env 后填写）
# 未配置时系统自动使用本地演示模板，报告中会标记 DEMO_ENGINE。

# 首次建库时用于初始化首位超级管理员；留空则不会写入初始密码。
# 已有数据库不受影响。请只在首次部署时设置一个强密码，然后从 .env 移除或留空。
ADMIN_INITIAL_PASSWORD=

# 登录会话与锁定策略
ADMIN_SESSION_HOURS=12
ADMIN_MAX_LOGIN_FAILURES=5
ADMIN_LOCK_MINUTES=15

# 必填：多模态模型 API Key
MULTIMODAL_API_KEY=

# 火山方舟 / 豆包 Seed 2.0
# MULTIMODAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MULTIMODAL_MODEL=<你的推理接入点 Endpoint ID>

# OpenAI 兼容接口
# MULTIMODAL_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_MODEL=gpt-4o

# 超时秒数，长报告建议 180-300
MULTIMODAL_TIMEOUT_SECONDS=240

# 生成失败时是否允许降级为演示报告；生产验收建议 false
ALLOW_DEMO_REPORT=false
