# 心理沙盘系统环境配置示例
# 复制为 backend/.env 后按部署环境填写；不要把真实 .env 提交到 Git。

# 运行环境：production / development
APP_ENV=production

# 对外访问地址必须使用 HTTPS 域名；报告图片、分享二维码都会使用该地址。
PUBLIC_BASE_URL=https://sandplay.example.com

# 允许跨域访问的前端来源，多个用英文逗号分隔；不要使用 *。
CORS_ORIGINS=https://sandplay.example.com

# 数据库：公网多用户部署建议 PostgreSQL；单校小规模部署才使用 SQLite。
# DATABASE_URL=postgresql+psycopg://sandplay:change-me@127.0.0.1:5432/sandplay
DATABASE_URL=sqlite:///./data/sandplay.db
# DATA_DIR=/srv/sandplay/data

# 首次空库初始化：必须设置强密码，否则系统拒绝创建无密码管理员。
# 初始化完成后建议将 ADMIN_INITIAL_PASSWORD 留空，并从部署环境中移除。
ADMIN_INITIAL_ACCOUNT=admin
ADMIN_INITIAL_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=

# 仅开发/演示环境可设为 true；公网生产必须为 false，避免演示账号进入生产库。
SEED_DEMO_USERS=false

# 登录会话与账号锁定
ADMIN_SESSION_HOURS=12
ADMIN_MAX_LOGIN_FAILURES=5
ADMIN_LOCK_MINUTES=15

# 分享链接默认有效期（天）。设为 30 表示家长/学生二维码 30 天后自动失效。
SHARE_DEFAULT_EXPIRES_DAYS=30

# 沙盘图 / 成绩单图片的短期签名密钥。生产必须单独设置为强随机值。
# 可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成。
MEDIA_SIGNING_SECRET=
MEDIA_SIGNED_URL_TTL_SECONDS=604800

# FastAPI /docs、/redoc、/openapi.json；公网生产建议关闭。
ENABLE_API_DOCS=false

# 内部操作手册（/manual）含后台截图与示例账号信息；生产必须关闭。
ENABLE_MANUAL=false

# 服务令牌仅用于受控运维脚本；公网部署默认关闭，且必须显式配置强随机值才生效。
ENABLE_SERVICE_TOKEN=false
COUNSELOR_TOKEN=

# 多模态模型（火山方舟 / 豆包 Seed 2.0）
MULTIMODAL_API_KEY=
# MULTIMODAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MULTIMODAL_MODEL=<推理接入点 Endpoint ID>
# 超时秒数，长报告建议 180-300
MULTIMODAL_TIMEOUT_SECONDS=300

# OpenAI 兼容接口示例
# MULTIMODAL_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_MODEL=gpt-4o

# 生成失败时是否降级为演示报告；公网生产必须为 false。
ALLOW_DEMO_REPORT=false
